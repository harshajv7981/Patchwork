# Copy to .env and fill in values. .env is gitignored — never commit real keys.

# Database
DATABASE_URL=postgresql+asyncpg://localhost:5432/patchwork

# GitHub API token (needed to open PRs / avoid rate limits): https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=replace_with_a_random_secret

# LLM provider: gemini (recommended, free) | groq | openrouter | ollama
LLM_PROVIDER=gemini

# Gemini — free tier fits code generation; key at https://aistudio.google.com/
# Verify your current limits at https://aistudio.google.com/rate-limit
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TRIAGE_MODEL=gemini-flash-lite-latest
GEMINI_CODING_MODEL=gemini-flash-lite-latest
GEMINI_REVIEW_MODEL=gemini-flash-lite-latest

# Groq — fastest, free, but ~8K tokens/minute (good for triage, not coding)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=medium

# OpenRouter — free models capped at 50 req/day until $10 lifetime credit
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Ollama — fully local/private, unlimited, needs a capable GPU
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b

# Sandbox: docker (secure default; build Dockerfile.sandbox first) | process
SANDBOX_RUNTIME=docker
SANDBOX_DOCKER_IMAGE=patchwork-sandbox:latest
# SANDBOX_PYTHON=/usr/bin/python3   # optional: interpreter for process-mode sandbox
